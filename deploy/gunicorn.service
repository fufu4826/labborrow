[Unit]
Description=LabBorrow Gunicorn (Django)
After=network.target mysql.service

[Service]
User=labborrow
Group=www-data
RuntimeDirectory=labborrow
RuntimeDirectoryMode=0750
WorkingDirectory=/srv/labborrow/app
EnvironmentFile=/srv/labborrow/app/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/labborrow/venv/bin/gunicorn config.wsgi:application \
    --workers 3 --bind unix:/run/labborrow/gunicorn.sock --umask 007 \
    --access-logfile - --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
