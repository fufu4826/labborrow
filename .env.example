# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# sqlite (default) or mysql
DB_ENGINE=sqlite
DB_NAME=labborrow
DB_USER=labborrow
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# LINE Messaging API (LINE Developers console). Leave empty to disable sending.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OA_BASIC_ID=
